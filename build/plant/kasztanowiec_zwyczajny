        <h3>📝 Notatki i Obserwacje</h3>

        
            <div class="alert alert-light border text-center">
                <a href="/login">Zaloguj się</a>, aby dodawać notatki.
            </div>
        

        <div class="comments-list">
            
        </div>
    </section>

</article>

