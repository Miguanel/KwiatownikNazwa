    <div class="frozen-modal-content">
        <span class="frozen-modal-close" onclick="closeFrozenModal()">&times;</span>
        <h3 style="color: #2d5a27;"><i class="bi bi-info-circle"></i> Funkcja wstrzymana</h3>
        <p class="mt-3">
            Aby aplikacja mogła być dostępna za darmo i działać błyskawicznie, przeszliśmy na wersję statyczną.
            Moduł logowania i komentarzy jest obecnie <strong>wyłączony</strong>.
        </p>
        <p>
            Jeśli projekt Ci się podoba i chcesz wesprzeć jego rozwój, możesz postawić mi wirtualną kawę! 🌱
        </p>
        <a href="https://buycoffee.to/miguana" target="_blank" class="btn btn-warning mt-3 fw-bold" style="background-color: #d4a017; border: none; color: white; padding: 10px 20px;">
            <i class="bi bi-cup-hot"></i> Postaw Kawę
        </a>
    </div>
</div>

<script>
    const frozenElements = document.querySelectorAll('.frozen-feature');
    const modal = document.getElementById('frozenModal'); // Jeśli nie ma HTMLa wyżej, to tutaj wyskakuje Twój błąd (null)

    frozenElements.forEach(el => {
        el.addEventListener('click', function(e) {
            e.preventDefault();
            if(modal) { // Zabezpieczenie, żeby skrypt nie "wybuchał"
                modal.style.display = "block";
            } else {
                console.error("Nie znaleziono okienka frozenModal w kodzie HTML!");
            }
        });
    });

    function closeFrozenModal() {
        if(modal) modal.style.display = "none";
    }

    window.onclick = function(event) {
        if (event.target == modal) {
            closeFrozenModal();
        }
    }
</script>

</body>
</html>