        <div class="col-lg-6">
            <h3 class="section-title">Kalendarz Biodynamiczny</h3>
            <div class="calendar-list">
                
                <div class="calendar-item mb-3 p-3 bg-white border">
                    <div class="d-flex justify-content-between align-items-start">
